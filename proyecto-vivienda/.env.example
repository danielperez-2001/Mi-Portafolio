# -------------------------------------------------------------
# Sistema de Alquileres La Estanza - Variables de Entorno
# -------------------------------------------------------------

# Nombre y entorno de la aplicación
APP_NAME="La Estanza - Sistema de Alquileres"
APP_ENV=local
APP_DEBUG=true

# URL base de la aplicación (sin barra final)
# Para servidor embebido PHP (php -S localhost:8000 router.php):
APP_URL="http://localhost:8000"
# Para XAMPP con VirtualHost apuntando a public/:
# APP_URL="http://laestanza.local"
# Para XAMPP en subcarpeta:
# APP_URL="http://localhost/proyecto%20de%20vivienda/public"

# Zona horaria y formato
APP_TIMEZONE="America/Guatemala"
APP_LOCALE="es"

# Configuración de base de datos (Reservada para Etapa 2)
# Nota: La etapa actual no conecta a base de datos ni ejecuta SQL.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=la_estanza_alquileres
DB_USERNAME=root
DB_PASSWORD=

# Modo demostración activo (fuerza mensajes y previene persistencia)
DEMO_MODE=true
